{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run src/modules/portal/portal.isolation.test.ts src/modules/workflows/workflows.integration.test.ts src/modules/quotes/quotes.integration.test.ts src/modules/campaigns/campaigns.integration.test.ts src/modules/support/sla.integration.test.ts src/modules/subscriptions/subscriptions.integration.test.ts src/modules/assignment/assignment.integration.test.ts src/modules/goals/goals.integration.test.ts src/modules/documents/documents.integration.test.ts src/modules/auth/two-factor.integration.test.ts src/modules/auth/login.integration.test.ts src/modules/api-keys/api-keys.integration.test.ts src/modules/privacy/privacy.integration.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "docs:openapi": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node dist/modules/docs/generate.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:sync-permissions": "tsx src/database/sync-permissions.ts",
    "db:grant-defaults": "tsx src/database/grant-defaults.ts",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.90.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
